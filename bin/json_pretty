#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: json_pretty [FLAGS] <json_file>

Validate and pretty print a JSON file.
USAGE
}

tb_parse_common_flags "$@"
set -- "${TB_POSITIONAL[@]}"

if (( TB_SHOW_HELP == 1 )); then
  usage
  exit 0
fi

(( $# == 1 )) || die "Usage: json_pretty <json_file>"

json_file=$1
[[ -f "$json_file" ]] || die "JSON file not found: $json_file"
require_command python3

python3 -m json.tool "$json_file"
