#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: disk_report [FLAGS] [path]

Show filesystem usage and top 10 largest items in the target path.
USAGE
}

tb_parse_common_flags "$@"
set -- "${TB_POSITIONAL[@]}"

if (( TB_SHOW_HELP == 1 )); then
  usage
  exit 0
fi

(( $# <= 1 )) || die "Usage: disk_report [path]"

path=${1:-.}
[[ -d "$path" ]] || die "Directory not found: $path"

printf 'Disk usage report for: %s\n' "$path"
printf 'Generated at: %s\n\n' "$(date -u '+%Y-%m-%d %H:%M:%S UTC')"

echo '== Filesystem usage =='
df -h "$path"
echo
echo '== Largest items (top 10) =='
du -ah "$path" 2>/dev/null | sort -hr | head -n 10
