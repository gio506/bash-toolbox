#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: rotate_logs [FLAGS] <log_dir> [keep_count]

Keep newest N .log files in a directory and remove older files.
USAGE
}

tb_parse_common_flags "$@"
set -- "${TB_POSITIONAL[@]}"

if (( TB_SHOW_HELP == 1 )); then
  usage
  exit 0
fi

(( $# >= 1 && $# <= 2 )) || die "Usage: rotate_logs <log_dir> [keep_count]"

log_dir=$1
keep_count=${2:-5}

[[ -d "$log_dir" ]] || die "Log directory not found: $log_dir"
[[ "$keep_count" =~ ^[0-9]+$ ]] || die "keep_count must be a non-negative integer"

mapfile -t logs < <(find "$log_dir" -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' | sort -nr | awk '{print $2}')

if (( ${#logs[@]} <= keep_count )); then
  log_info "Nothing to rotate. Found ${#logs[@]} log(s), keeping $keep_count."
  exit 0
fi

for ((i=keep_count; i<${#logs[@]}; i++)); do
  rm -f "${logs[$i]}"
  log_info "Removed old log: ${logs[$i]}"
done
